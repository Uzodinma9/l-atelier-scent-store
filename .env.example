# ---- Browser (Vite) ----
# These two are inlined into the client bundle, so only use the publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Server only (never prefix with VITE_) ----
# Used by the /api/send-order serverless function to send order emails via Mailgun.
# Find these in Mailgun: Sending -> Domains, and Account -> API keys.
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=sandboxxxxxxxxxxxxxxxxxxxxxxxxx.mailgun.org
MAILGUN_FROM="L'Atelier Scent <orders@your-domain.com>"
# Where the atelier receives new-order notifications (optional).
ORDER_NOTIFICATION_EMAIL=orders@your-domain.com
# Only for EU-region Mailgun domains (default is https://api.mailgun.net).
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# ---- Optional: store orders in Supabase ----
# Set both to also save each order to an `orders` table. Requires the
# service role key (server only) and the SQL at the bottom of README.md.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
